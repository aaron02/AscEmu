#pragma once

/*! \brief
 *  AE_CLIENT_PROFILE selects the external client protocol (Classic..Forever).
 *  VERSION_STRING selects the actual core/client profile. Modern clients use
 *  their own profile value and never masquerade as an older expansion.
 */
#define Classic 5875
#define TBC 8606
#define WotLK 12340
#define Cata 15595
#define Mop 18414
#define AE_PROFILE_MIDNIGHT 69814
// Forever has no supported public build profile yet. This is only a unique
// compile-time profile token; BUILD_VERSION remains 0 until one is added.
#define AE_PROFILE_FOREVER 100000

#define AE_CLIENT_PROFILE @ASCEMU_VERSION_TOKEN@

#if AE_CLIENT_PROFILE == Classic
    #define AE_CLASSIC
    #define VERSION 1, 12, 1
    #define VERSION_STRING Classic
    #define BUILD_VERSION 5875
#elif AE_CLIENT_PROFILE == TBC
    #define AE_TBC
    #define VERSION 2, 4, 3
    #define VERSION_STRING TBC
    #define BUILD_VERSION 8606
#elif AE_CLIENT_PROFILE == WotLK
    #define AE_WOTLK
    #define VERSION 3, 3, 5
    #define VERSION_STRING WotLK
    #define BUILD_VERSION 12340
#elif AE_CLIENT_PROFILE == Cata
    #define AE_CATA
    #define VERSION 4, 3, 4
    #define VERSION_STRING Cata
    #define BUILD_VERSION 15595
#elif AE_CLIENT_PROFILE == Mop
    #define AE_MOP
    #define VERSION 5, 4, 8
    #define VERSION_STRING Mop
    #define BUILD_VERSION 18414
#elif AE_CLIENT_PROFILE == AE_PROFILE_MIDNIGHT
    #define AE_MIDNIGHT
    #define AE_MODERN_CLIENT
    #define AE_BATTLENET
    #define VERSION 12, 1, 0
    #define VERSION_STRING AE_PROFILE_MIDNIGHT
    #define BUILD_VERSION 69814
#elif AE_CLIENT_PROFILE == AE_PROFILE_FOREVER
    #define AE_FOREVER
    #define AE_MODERN_CLIENT
    #define AE_BATTLENET
    #define VERSION 0, 0, 0
    #define VERSION_STRING AE_PROFILE_FOREVER
    #define BUILD_VERSION 0
#else
    #error Unsupported ASCEMU_VERSION
#endif

#if VERSION_STRING >= Classic
    #define GM_TICKET_MY_MASTER_COMPATIBLE
#endif

#if VERSION_STRING >= TBC
    #define FT_FLYING
#endif

#if VERSION_STRING >= WotLK
    #define FT_ACHIEVEMENTS
    #define FT_DEATH_KNIGHT
    #define FT_DUAL_SPEC
    #define FT_DUNGEON_FINDER
    #define FT_GLYPHS
    #define FT_VEHICLES
#endif

#if VERSION_STRING >= Cata
    #define FT_TRANSMOG
    #define FT_LFR
#endif
